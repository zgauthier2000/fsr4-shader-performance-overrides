# Shader dumps and everything built from them contain AMD's shader code: never commit them.
dump*/
override*/
build/
*.spv
*.spvasm
*.dxil
*.dxbc

# The prebuilt overrides are meant to be shared (see prebuilt/NOTICE.md).
!prebuilt/
!prebuilt/*.spv

# Windows: the prebuilt add-on and its DXIL replacements are shared too (see windows/prebuilt/NOTICE.md).
!windows/prebuilt/fsr4-overrides/*.dxil
